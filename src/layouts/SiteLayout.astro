---
import '../styles/site.css';
import profile from '../data/profile.json';
const { title, description, active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`;
const nav = [
  { label: 'Home', path: '' },
  { label: 'Experience', path: 'experience/' },
  { label: 'Blog', path: 'blog/' },
  { label: 'Contact', path: 'contact/' },
];
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%2320231f'/%3E%3Cpath d='M16 16v32m32-32v32M16 32h32' stroke='%23e78a63' stroke-width='7'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | {profile.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <header class="shell nav">
      <a href={link('')} class="brand">Harmeet<span>.</span></a>
      <nav aria-label="Main navigation">
        {nav.map(item => <a href={link(item.path)} aria-current={active === item.label ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="footer"><div class="shell footer-inner"><span>© 2026 {profile.name}</span><a href={`mailto:${profile.email}`}>{profile.email}</a></div></footer>
  </body>
</html>
