---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('en-IN', { day:'numeric', month:'long', year:'numeric', timeZone:'Asia/Kolkata' }).format(post.data.pubDate);
---
<SiteLayout title={post.data.title} description={post.data.description} active="Blog">
  <article class="article shell">
    <a class="text-link" href={`${base}blog/`}>← All writing</a>
    <div class="article-head"><span class="eyebrow">{post.data.sample ? 'Sample article' : post.data.category}</span><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><div class="post-stamp"><time datetime={post.data.pubDate.toISOString()}>{date}</time><div class="tags" aria-label="Tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></div></div>
    <div class="article-body"><Content /></div>
  </article>
</SiteLayout>
