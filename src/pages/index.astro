---
import SiteLayout from "../layouts/SiteLayout.astro";
import profile from "../data/profile.json";
import projects from "../data/projects.json";
import topics from "../data/blog-topics.json";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<SiteLayout
  title="Solution Architect"
  description="Solution architecture, cloud platforms, distributed systems and applied AI."
  active="Home"
>
  <section class="hero shell">
    <div class="intro">
      <span class="eyebrow">{profile.role} · {profile.location}</span>
      <h1>{profile.headline}</h1>
      <p class="lead">{profile.summary}</p>
      <div class="expertise">
        {profile.expertise.map((item) => <span>{item}</span>)}
      </div>
      <div class="actions">
        <a class="text-link" href={link("experience/")}>View experience ↗</a><a
          class="text-link"
          href={link("contact/")}>Get in touch ↗</a
        >
      </div>
    </div>
    {
      profile.photo ? (
        <div class="portrait portrait-photo">
          <img
            src={link(profile.photo)}
            alt={`Portrait of ${profile.name}`}
            width="160"
            height="206"
          />
        </div>
      ) : (
        <div
          class="portrait"
          role="img"
          aria-label={`Portrait placeholder for ${profile.name}`}
        >
          <div class="portrait-mark">HS</div><span>Photo coming soon</span>
        </div>
      )
    }
  </section>
  <section class="section shell">
    <div class="section-title">
      <div>
        <span class="eyebrow">Selected work</span><h2>Project highlights</h2>
      </div><a class="text-link" href={link("experience/")}>Full experience ↗</a
      >
    </div>
    <div class="highlights">
      {
        projects.highlights.map((project) => (
          <article>
            {project.logo ? (
              <img
                class="project-logo"
                src={link(project.logo)}
                alt={`${project.organization} logo`}
              />
            ) : (
              <div class="logo-placeholder" aria-label="Logo placeholder">
                <span>Logo</span>
              </div>
            )}
            <>
              <span class="meta">
                {project.organization} · {project.category}
              </span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section shell">
    <div class="section-title">
      <div>
        <span class="eyebrow">Outside work</span><h2>Community projects</h2>
      </div>
    </div>
    <div class="posts">
      {
        projects.community.map((project) => (
          <article>
            {project.logo ? (
              <img
                class="project-logo"
                src={link(project.logo)}
                alt={`${project.title} logo`}
              />
            ) : (
              <div class="logo-placeholder" aria-label="Logo placeholder">
                <span>Logo</span>
              </div>
            )}
            <>
              <span class="meta">{project.type}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a
                class="text-link"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {project.linkLabel} ↗
              </a>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section shell">
    <div class="section-title">
      <div><span class="eyebrow">Writing</span><h2>Featured writing</h2></div><a
        class="text-link"
        href={link("blog/")}>Visit the blog ↗</a
      >
    </div>
    <div class="posts">
      {
        posts.slice(0, 5).map((post) => (
          <article>
            <>
              <span class="meta">
                {post.data.category}
              </span>
              <h3>
                <a href={link(`blog/${post.id}/`)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <a class="text-link" href={link(`blog/${post.id}/`)}>
                Read article ↗
              </a>
            </>
          </article>
        ))
      }
      <!-- {
        topics.slice(0, 5).map(
          (topic) =>
            topic.featured == true && (
              <article>
                <>
                  <span class="meta">
                    {topic.status} · {topic.category}
                  </span>
                  <h3>{topic.title}</h3>
                  <p>{topic.description}</p>
                  <a class="text-link" href={link(`blog/${topic.category}/`)}>
                    Read article ↗
                  </a>
                </>
              </article>
            ),
        )
      } -->
    </div>
    <!-- <p class="note">
      The article is sample content; the other topic is in preparation.
    </p> -->
  </section>
</SiteLayout>
